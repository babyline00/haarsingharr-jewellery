# ============================================================================
# Haarsingharr Jewellery Store — Environment Configuration Template
# ----------------------------------------------------------------------------
# Copy this file to ".env" on your server and fill in real values.
# Never commit ".env" to source control. Never use production credentials
# in development. Rotate keys before launching the public store.
# ============================================================================

APP_NAME="Haarsingharr.pk"
APP_BRAND_SHORT="HAARSINGHARR"
APP_TAGLINE="Jewelry For Every You"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.haarsingharr.pk
APP_FORCE_HTTPS=true
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR
APP_CURRENCY_SYMBOL=Rs.
APP_CURRENCY_POSITION=before

ADMIN_PATH=admin
# ADMIN_DOMAIN=admin.haarsingharr.example     # Optional: serve admin on a subdomain

# Frontend assets (leave blank unless using a CDN)
ASSET_URL=

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=haarsingharr_jewellery
DB_USERNAME=
DB_PASSWORD=
DB_SOCKET=
DB_FOREIGN_KEYS=true
# DB_PERSISTENT=false                    # enable persistent connections if needed
# MYSQL_ATTR_SSL_CA=
# MYSQL_ATTR_SSL_CERT=
# MYSQL_ATTR_SSL_KEY=
# MYSQL_ATTR_SSL_VERIFY_SERVERCERT=false

# --------------------------------------------------------------------------
# Cache, Session, Queue
# --------------------------------------------------------------------------
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFESPAN=120
SESSION_COOKIE=haars_session
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SESSION_DOMAIN=
SESSION_ROTATE_ON_AUTH=true
SESSION_SINGLE_ACTIVE=false
QUEUE_CONNECTION=database

# Redis (optional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
CACHE_PREFIX=haarsingharr_

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-host.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=60
MAIL_VERIFY_PEER=true
MAIL_FROM_ADDRESS=orders@haarsingharr.example
MAIL_FROM_NAME="Haarsingharr Jewellery"
MAIL_REPLY_TO_ADDRESS=care@haarsingharr.example
MAIL_REPLY_TO_NAME="Haarsingharr Customer Care"

# --------------------------------------------------------------------------
# Authentication & Security
# --------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=15
MFA_ENABLED=true
SESSION_PARTITIONED_COOKIE=false

# --------------------------------------------------------------------------
# Storefront configuration
# --------------------------------------------------------------------------
SHIPPING_DEFAULT_METHOD=standard
SHIPPING_FREE_THRESHOLD=25000
SHIPPING_FLAT_RATE=350
SHIPPING_EXPRESS_RATE=700
SHIPPING_COD_ELIGIBLE=true
SHIPPING_DIM_UNIT=cm
SHIPPING_WEIGHT_UNIT=g
SHIPPING_HANDLING_DAYS=1

TAX_ENABLED=false
TAX_INCLUSIVE=true
TAX_DEFAULT_RATE=0

INVENTORY_RESERVE_MINUTES=30
INVENTORY_BACKORDERS=false
INVENTORY_LOW_STOCK=5

CART_EXPIRE_MINUTES=43200
CART_GUEST_EXPIRE_MINUTES=10080
CART_MAX_ITEMS=50
CART_MAX_QTY=20

REVIEWS_ENABLED=true
REVIEWS_REQUIRE_PURCHASE=true
REVIEWS_AUTO_APPROVE=false
REVIEWS_MAX_IMAGES=3
REVIEWS_DAILY_LIMIT=3

WISHLIST_ENABLED=true
WISHLIST_MAX=100

NOTIFY_ORDER_PLACED=true
NOTIFY_ORDER_PAID=true
NOTIFY_ORDER_SHIPPED=true
NOTIFY_ORDER_DELIVERED=true
NOTIFY_ORDER_CANCELLED=true
NOTIFY_LOW_STOCK=true
WHATSAPP_NUMBER=

UPLOAD_MAX_IMAGE_KB=6144
UPLOAD_IMAGE_MIMES=jpg,jpeg,png,webp,avif
UPLOAD_MAX_WIDTH=2500
UPLOAD_MAX_HEIGHT=2500

CONTACT_EMAIL=care@haarsingharr.example
CONTACT_PHONE=+92 300 0000000
CONTACT_WHATSAPP=+92 300 0000000
CONTACT_ADDRESS="Main Boulevard, Lahore, Pakistan"
CONTACT_HOURS="Mon–Sat, 10:00–20:00 PKT"

SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_TIKTOK=
SOCIAL_PINTEREST=
SOCIAL_YOUTUBE=

COMPANY_NAME="Haarsingharr Jewellers (Pvt) Ltd"
COMPANY_NTN=
COMPANY_REGISTRATION=

# --------------------------------------------------------------------------
# Payment gateways
# --------------------------------------------------------------------------
PAYMENT_CURRENCY=PKR
PAYMENT_COUNTRY=PK

COD_ENABLED=true
COD_MAX_VALUE=200000
COD_FEE=0
COD_CONFIRMATION_REQUIRED=true

JAZZCASH_ENABLED=false
JAZZCASH_ENV=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=/payments/return/jazzcash
JAZZCASH_API_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchanttrans/
JAZZCASH_VERIFY_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/querytms/

EASYPAYSA_ENABLED=false
EASYPAYSA_ENV=sandbox
EASYPAYSA_STORE_ID=
EASYPAYSA_HASH=
EASYPAYSA_ACCOUNT_NUM=
EASYPAYSA_RETURN_URL=/payments/return/easypaisa
EASYPAYSA_POST_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf
EASYPAYSA_CONFIRM_URL=https://easypay.easypaisa.com.pk/easypay/Confirm.jsf

STRIPE_ENABLED=false
STRIPE_ENV=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PAYMENT_VERIFY_AMOUNT=true
PAYMENT_VERIFY_CURRENCY=true
PAYMENT_VERIFY_MERCHANT=true
PAYMENT_VERIFY_STATE=true
PAYMENT_WEBHOOK_TIMEOUT=30
PAYMENT_RETURN_SECONDS=600
PAYMENT_VERIFY_RETRIES=3

REFUND_REQUIRE_APPROVAL=true
REFUND_MAX_PARTIAL_PCT=100

PAYMENT_EVENT_RETENTION=365
PAYMENT_LOG_DAYS=90
AUDIT_LOG_DAYS=90
SECURITY_LOG_DAYS=180

# --------------------------------------------------------------------------
# Features (toggle modules on/off)
# --------------------------------------------------------------------------
FEATURE_GUEST_CHECKOUT=true
FEATURE_WISHLIST=true
FEATURE_PRODUCT_QUESTIONS=true
FEATURE_REVIEWS=true
FEATURE_NEWSLETTER=true
FEATURE_MFA_REQUIRED=true
FEATURE_WHATSAPP_CLICK_CHAT=true

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# --------------------------------------------------------------------------
# PHP runtime overrides (applied when possible)
# --------------------------------------------------------------------------
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=120
PHP_UPLOAD_MAX=12M
PHP_POST_MAX=12M
